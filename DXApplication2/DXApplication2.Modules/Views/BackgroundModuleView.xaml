<UserControl x:Class="DXApplication2.Modules.Views.BackgroundModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:DXApplication2.Modules.ViewModels"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance viewModels:BackgroundModuleViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Radio 顶部 -->
            <Border Grid.Row="0" Padding="10,5" Background="#FAFAFA" BorderThickness="0,0,0,1" BorderBrush="#DDDDDD">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="None" GroupName="BgMode" IsChecked="{Binding IsNoneMode, Mode=TwoWay}" Margin="0,0,20,0"/>
                    <RadioButton Content="Image" GroupName="BgMode" IsChecked="{Binding IsImageMode, Mode=TwoWay}" Margin="0,0,20,0"/>
                    <RadioButton Content="Pump" GroupName="BgMode" IsChecked="{Binding IsPumpMode, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <scottplot:WpfPlot x:Name="PlotControl" Grid.Row="1"/>

            <Border Grid.Row="2" Padding="10,4" Background="#F5F5F5" BorderThickness="0,1,0,0" BorderBrush="#DDDDDD">
                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray"/>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="#FAFAFA" BorderThickness="1,0,0,0" BorderBrush="#DDDDDD">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <TextBlock Text="Background Config" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <CheckBox Content="Apply to PSHG raw processing" 
                              IsChecked="{Binding ApplyToPshgRaw, Mode=TwoWay}" 
                              Margin="0,5,0,15"/>

                    <!-- Image Background -->
                    <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Image Background" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ImageInfo}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                            <dx:SimpleButton Content="Clear" Command="{Binding ClearImageCommand}" Padding="10,3" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Pump Background -->
                    <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Pump Background" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding PumpInfo}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <dx:SimpleButton Content="Fit" Command="{Binding FitPumpCommand}" Padding="10,3" Margin="0,0,5,0"/>
                                <dx:SimpleButton Content="Clear" Command="{Binding ClearPumpCommand}" Padding="10,3"/>
                            </StackPanel>
                            <TextBlock Text="Pump Scale" FontWeight="SemiBold" Margin="0,10,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                    Value="{Binding PumpScale, Mode=TwoWay}"
                                    Minimum="0" Maximum="2" 
                                    SmallChange="0.05"
                                    VerticalAlignment="Center"/>
                                <dxe:SpinEdit Grid.Column="1"
                                          Value="{Binding PumpScale, Mode=TwoWay}"
                                          MinValue="0" MaxValue="2" Increment="0.05"
                                          MaskType="Numeric" Mask="F2"
                                          Width="60" Margin="5,0,0,0"/>
                             </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Image display config -->
                    <StackPanel Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Display" FontSize="14" FontWeight="Bold" Margin="0,10,0,5"/>

                        <TextBlock Text="Colormap" FontWeight="SemiBold" Margin="0,5,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableColormaps}" SelectedItem="{Binding Colormap, Mode=TwoWay}"/>

                        <TextBlock Text="Z Range" FontWeight="SemiBold" Margin="0,10,0,3"/>
                        <TextBlock Text="{Binding ZMinValue, StringFormat={}Min: {0:G3}}" FontSize="10" Foreground="Gray"/>
                        <Slider Value="{Binding ZMinValue, Mode=TwoWay}" Minimum="{Binding ZRangeMin}" Maximum="{Binding ZRangeMax}"/>
                        <TextBlock Text="{Binding ZMaxValue, StringFormat={}Max: {0:G3}}" FontSize="10" Foreground="Gray"/>
                        <Slider Value="{Binding ZMaxValue, Mode=TwoWay}" Minimum="{Binding ZRangeMin}" Maximum="{Binding ZRangeMax}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>