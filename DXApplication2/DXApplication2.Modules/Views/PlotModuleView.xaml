<UserControl x:Class="DXApplication2.Modules.Views.PlotModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewModels="clr-namespace:DXApplication2.Modules.ViewModels"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance viewModels:PlotModuleViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧:绘图 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <scottplot:WpfPlot x:Name="PlotControl" Grid.Row="0"/>

            <Border Grid.Row="1" Padding="10,4" Background="#F5F5F5" BorderThickness="0,1,0,0" BorderBrush="#DDDDDD">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="Gray" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding MouseCoordinate}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧:配置面板 -->
        <Border Grid.Column="1" Background="#FAFAFA" BorderThickness="1,0,0,0" BorderBrush="#DDDDDD">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <TextBlock Text="Plot Config" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <dx:SimpleButton Content="Export CSV" 
                         Command="{Binding ExportCsvCommand}"
                         Margin="0,0,0,15"
                         Padding="15,5"/>

                    <!-- 后面 Y Axis 保持不变 -->
                    <!-- 新加:Y Axis Field -->
                    <TextBlock Text="Y Axis" FontWeight="SemiBold" Margin="0,5,0,3"/>
                    <ComboBox ItemsSource="{Binding AvailableFields}"
                        SelectedItem="{Binding SelectedYField, Mode=TwoWay}"/>

                    <!-- 新加:X Axis Field -->
                    <TextBlock Text="X Axis" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <ComboBox ItemsSource="{Binding AvailableFields}"
                        SelectedItem="{Binding SelectedXField, Mode=TwoWay}"/>
                    <!-- Z Axis(仅 Heatmap) -->
                    <StackPanel Visibility="{Binding IsHeatmap, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Z Axis" FontWeight="SemiBold" Margin="0,10,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableFields}"
                            SelectedItem="{Binding SelectedZField, Mode=TwoWay}"/>

                        <TextBlock Text="Colormap" FontWeight="SemiBold" Margin="0,10,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableColormaps}"
                            SelectedItem="{Binding Colormap, Mode=TwoWay}"/>

                        <TextBlock Text="Z Range" FontWeight="SemiBold" Margin="0,10,0,3"/>
                        <TextBlock Text="{Binding ZMinValue, StringFormat={}{0:G3}}" FontSize="10" Foreground="Gray"/>
                        <Slider Value="{Binding ZMinValue, Mode=TwoWay}"
                            Minimum="{Binding ZRangeMin}"
                            Maximum="{Binding ZRangeMax}"
                            TickFrequency="0.01" IsSnapToTickEnabled="False"/>
                        <TextBlock Text="{Binding ZMaxValue, StringFormat={}{0:G3}}" FontSize="10" Foreground="Gray"/>
                        <Slider Value="{Binding ZMaxValue, Mode=TwoWay}"
                            Minimum="{Binding ZRangeMin}"
                            Maximum="{Binding ZRangeMax}"
                            TickFrequency="0.01" IsSnapToTickEnabled="False"/>
                    </StackPanel>
                    <!-- Polar 相关(仅 Polar/PolarFilled 模式) -->
                    <StackPanel Visibility="{Binding IsPolar, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Curves" FontWeight="SemiBold" Margin="0,15,0,3"/>
                        <ItemsControl ItemsSource="{Binding AvailableCurves}"
                            BorderThickness="1"
                            BorderBrush="#CCCCCC"
                            MaxHeight="200">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="4,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- 字体 -->
                    <TextBlock Text="Font Family" FontWeight="SemiBold" Margin="0,5,0,3"/>
                    <ComboBox SelectedItem="{Binding FontName, Mode=TwoWay}">
                        <sys:String>Arial</sys:String>
                        <sys:String>Helvetica</sys:String>
                        <sys:String>Times New Roman</sys:String>
                        <sys:String>Calibri</sys:String>
                    </ComboBox>

                    <TextBlock Text="Font Size" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <dx:SimpleButton Command="{Binding DecreaseFontCommand}"
                                          Width="30" Height="30" Margin="0,0,5,0"
                                          Glyph="{dx:DXImage 'SvgImages/DiagramIcons/DecreaseFontSize.svg'}"
                                          ToolTip="Decrease font size"/>
                        <TextBlock Text="{Binding BaseFontSize}" 
                                   Width="40" TextAlignment="Center" 
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <dx:SimpleButton Command="{Binding IncreaseFontCommand}"
                                          Width="30" Height="30" Margin="5,0,0,0"
                                          Glyph="{dx:DXImage 'SvgImages/DiagramIcons/IncreaseFontSize.svg'}"
                                          ToolTip="Increase font size"/>
                    </StackPanel>

                    <!-- Frame -->
                    <CheckBox Content="Show top/right frame" 
                              IsChecked="{Binding ShowFrame, Mode=TwoWay}"
                              Margin="0,15,0,0"/>

                    <!-- Margin -->
                    <TextBlock Text="Margin" FontWeight="SemiBold" Margin="0,15,0,3"/>
                    <StackPanel>
                        <RadioButton Content="Tight" GroupName="Margin" IsChecked="{Binding IsMarginTight, Mode=TwoWay}"/>
                        <RadioButton Content="Common" GroupName="Margin" IsChecked="{Binding IsMarginCommon, Mode=TwoWay}"/>
                        <RadioButton Content="Loose" GroupName="Margin" IsChecked="{Binding IsMarginLoose, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Legend Position -->
                    <TextBlock Text="Legend Position" FontWeight="SemiBold" Margin="0,15,0,3"/>
                    <StackPanel>
                        <RadioButton Content="Top-Right" GroupName="Legend" IsChecked="{Binding IsLegendTopRight, Mode=TwoWay}"/>
                        <RadioButton Content="Top-Left" GroupName="Legend" IsChecked="{Binding IsLegendTopLeft, Mode=TwoWay}"/>
                        <RadioButton Content="Bottom-Right" GroupName="Legend" IsChecked="{Binding IsLegendBottomRight, Mode=TwoWay}"/>
                        <RadioButton Content="Bottom-Left" GroupName="Legend" IsChecked="{Binding IsLegendBottomLeft, Mode=TwoWay}"/>
                        <RadioButton Content="Hidden" GroupName="Legend" IsChecked="{Binding IsLegendHidden, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- 标签 -->
                    <TextBlock Text="X Label" FontWeight="SemiBold" Margin="0,15,0,3"/>
                    <TextBox Text="{Binding XLabelOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Text="Y Label" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <TextBox Text="{Binding YLabelOverride, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <!-- Marker Style -->
                    <TextBlock Text="Marker Style" FontWeight="SemiBold" Margin="0,15,0,3"/>
                    <StackPanel>
                        <RadioButton GroupName="Marker" IsChecked="{Binding IsMarkerOpen, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="○"
                                     FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Open circle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Marker" IsChecked="{Binding IsMarkerFilled, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●"
                                     FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Filled circle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Marker" IsChecked="{Binding IsMarkerFilledOutlined, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉"
                             FontSize="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Filled + outline" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Marker Size -->
                    <TextBlock Text="Marker Size" FontWeight="SemiBold" Margin="0,15,0,3"/>
                    <dxe:SpinEdit Value="{Binding MarkerSize, Mode=TwoWay}"
                      MinValue="0" MaxValue="20" Increment="1"
                      MaskType="Numeric" Mask="F0"/>
                    <dx:SimpleButton Content="Edit Legend"
                 Command="{Binding EditLegendCommand}"
                 Margin="0,5,0,0"
                 Padding="10,3"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>