<dx:ThemedWindow x:Class="DXApplication2.Main.Views.ExperimentParamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        Title="Experiment Parameters" 
        Height="600" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <TextBlock Grid.Row="0" 
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" 
                   Foreground="Gray">
            Manage parameter definitions per experiment type.
            <LineBreak/>
            • Each parameter belongs to exactly one experiment type.
            <LineBreak/>
            • Same-name parameters can exist across different experiment types.
        </TextBlock>

        <!-- 筛选栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filter by Experiment Type:" 
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <dxe:ComboBoxEdit 
                Width="250"
                ItemsSource="{Binding AllExperimentTypes}"
                DisplayMember="Name"
                ValueMember="Id"
                EditValue="{Binding SelectedFilterTypeId, UpdateSourceTrigger=PropertyChanged}"
                ShowNullText="True"
                NullText="(All)"
                IsTextEditable="False"/>
        </StackPanel>

        <!-- 主表格 -->
        <dxg:GridControl Grid.Row="2"
                         x:Name="grid"
                         ItemsSource="{Binding FilteredParameters}"
                         AutoGenerateColumns="None"
                         SelectionMode="Row">
            <dxg:GridControl.View>
                <dxg:TableView 
                    ShowGroupPanel="False"
                    NewItemRowPosition="Bottom"
                    AllowPerPixelScrolling="True"
                    ShowTotalSummary="False"
                    NavigationStyle="Cell"/>
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                <dxg:GridColumn FieldName="Id" Header="ID" ReadOnly="True" Width="60"/>

                <!-- 实验类型下拉列 -->
                <dxg:GridColumn FieldName="ExperimentTypeId" Header="Experiment Type" Width="150">
                    <dxg:GridColumn.EditSettings>
                        <dxe:ComboBoxEditSettings 
                            ItemsSource="{Binding DataContext.AllExperimentTypes, RelativeSource={RelativeSource AncestorType=dxg:GridControl}}"
                            DisplayMember="Name"
                            ValueMember="Id"
                            IsTextEditable="False"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn FieldName="FieldName" Header="FieldName" Width="120"/>
                <dxg:GridColumn FieldName="DisplayName" Header="Display Name" Width="150"/>
                <dxg:GridColumn FieldName="Unit" Header="Unit" Width="80"/>
                <dxg:GridColumn FieldName="DataType" Header="Data Type" Width="100"/>
                <dxg:GridColumn FieldName="DisplayOrder" Header="Order" Width="70"/>
                <dxg:GridColumn FieldName="IsDeprecated" Header="Deprecated" Width="90"/>
                <dxg:GridColumn FieldName="Description" Header="Description" Width="*"/>
            </dxg:GridControl.Columns>
        </dxg:GridControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <dx:SimpleButton Content="Save" Width="80" Margin="5,0" 
                             Command="{Binding SaveCommand}"/>
            <dx:SimpleButton Content="Reload" Width="80" Margin="5,0"
                             Command="{Binding ReloadCommand}"/>
            <dx:SimpleButton Content="Delete Selected" Width="120" Margin="5,0"
                             Command="{Binding DeleteSelectedCommand}"
                             CommandParameter="{Binding SelectedItem, ElementName=grid}"/>
            <dx:SimpleButton Content="Close" Width="80" Margin="5,0" 
                             Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
    </dx:ThemedWindow>
